---
import { fetchCatalog, lowestPrice, formatPrice } from '../lib/api';
const catalog = await fetchCatalog();
const featured = catalog.slice(0, 6);
---
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bay 店铺 · 首页</title>
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, 'PingFang SC', 'Noto Sans CJK SC', sans-serif; color: #1f2937; background: #fff; }
      header { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-bottom: 1px solid #e5e7eb; }
      header .brand { font-weight: 700; font-size: 18px; }
      header nav a { margin-left: 16px; color: #374151; text-decoration: none; font-size: 14px; }
      header nav a:hover { color: #111827; }
      .hero { padding: 64px 24px 40px; text-align: center; background: linear-gradient(180deg, #f9fafb, #fff); }
      .hero h1 { margin: 0 0 12px; font-size: 32px; }
      .hero p { margin: 0; color: #6b7280; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; padding: 24px; max-width: 1080px; margin: 0 auto; }
      .card { border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px; text-decoration: none; color: inherit; display: block; transition: box-shadow 0.15s; }
      .card:hover { box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08); }
      .card h3 { margin: 0 0 8px; font-size: 16px; }
      .card .price { color: #b45309; font-weight: 600; }
      .card .sku-count { color: #9ca3af; font-size: 12px; }
      .empty { padding: 48px; text-align: center; color: #9ca3af; }
      footer { padding: 24px; text-align: center; color: #9ca3af; font-size: 12px; }
    </style>
  </head>
  <body>
    <header>
      <span class="brand">Bay 店铺</span>
      <nav><a href="/">首页</a><a href="/catalog">全部商品</a></nav>
    </header>
    <section class="hero">
      <h1>精选好物，一站选购</h1>
      <p>SSR 渲染的独立站骨架 · SF-10</p>
    </section>
    {
      featured.length > 0 ? (
        <div class="grid">
          {featured.map((item) => (
            <a class="card" href={`/catalog/${item.productId}`}>
              <h3>{item.title}</h3>
              <div class="price">{formatPrice(lowestPrice(item), item.skus[0]?.currency ?? 'CNY')} 起</div>
              <div class="sku-count">{item.skus.length} 个规格</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty">暂无在售商品（commerce-os 服务未连接或无 listed 商品）</div>
      )
    }
    <footer>Bay storefront · Astro SSR · data: commerce-os /api/v1/storefront/catalog</footer>
  </body>
</html>
