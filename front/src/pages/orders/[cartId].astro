---
import OrderIsland from '../../components/OrderIsland';
const cartId = Astro.params.cartId ?? '';
const apiBase = process.env.COMMERCE_API_BASE_URL ?? 'http://127.0.0.1:8787';
---
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>订单详情 · Bay 店铺</title>
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: -apple-system, 'PingFang SC', 'Noto Sans CJK SC', sans-serif; color: #1f2937; background: #fff; }
      header { display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-bottom: 1px solid #e5e7eb; }
      header .brand { font-weight: 700; font-size: 18px; }
      header nav a { margin-left: 16px; color: #374151; text-decoration: none; font-size: 14px; }
      main { max-width: 720px; margin: 0 auto; padding: 32px 24px; }
      footer { padding: 24px; text-align: center; color: #9ca3af; font-size: 12px; }
    </style>
  </head>
  <body>
    <header>
      <span class="brand">Bay 店铺</span>
      <nav><a href="/">首页</a><a href="/catalog">全部商品</a></nav>
    </header>
    <main>
      <OrderIsland client:load cartId={cartId} apiBase={apiBase} />
    </main>
    <footer>Bay storefront · order status via cart token · refunds gated by D2 approval</footer>
  </body>
</html>
