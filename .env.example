# commerce-os configuration (M3). All credentials are env-only; nothing
# channel-specific is stored in the business database.

# HTTP
COMMERCE_HOST=127.0.0.1
COMMERCE_PORT=8787
# When set, all /api/v1 routes require `Authorization: Bearer <token>`.
COMMERCE_API_TOKEN=

# Storage: sqlite (local, default) | postgres (production)
COMMERCE_DB_DRIVER=sqlite
# sqlite file path (local dev); use :memory: for ephemeral runs
COMMERCE_SQLITE_PATH=./data/commerce-os.db
# postgres (production); requires the optional `pg` dependency and is not
# exercised in local CI — the dialect boundary lives in src/storage only.
# COMMERCE_DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/commerce_os

# Decision kernel (zeus). The client never grades locally.
ZEUS_BASE_URL=http://127.0.0.1:8080
ZEUS_INTERNAL_TOKEN=dev-local-token
# When unset/Zeus unreachable, commerce APIs fail closed (502/503) rather
# than guessing a grade. Tests inject a recorded decision server instead.

# Channel credentials are referenced by id only (credentialRef); real
# secrets live in the deployment secret backend, never in git or the DB.
# SANDBOX channels need no credential and replay recorded fixtures only.

# Content base (loom). When set, listings use the real content service;
# when unset an offline stub is used (no network).
# LOOM_BASE_URL=http://127.0.0.1:8090
# LOOM_ACTOR_ID=commerce-os

# Alerts. Every alert is always written to stderr as a JSON line; when a
# webhook URL is set it is also POSTed there (e.g. a Feishu bot/relay).
# COMMERCE_ALERT_WEBHOOK=
